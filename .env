# Distribute
# penality_time > execution_time
# execution_HIGH + penality_LOW < execution_LOW + penality_HIGH
# penality_HIGH - penality_LOW > 2.5
# ...
DROP_PENALTY_HIGH_HOURS=7 # 4.008 одну агентскую точку отрежет
DROP_PENALTY_MIDDLE_HOURS=4 # 2.1 одну агентскую точку отрежет
DROP_PENALTY_LOW_HOURS=2 # 1.6 одну агентскую точку отрежет
SOLVER_TIME_LIMIT_SECONDS=60
RECENT_CONNECTION_DAYS=1
ROUTE_SOFT_DEADLINE_HIGH_SECONDS=7200
ROUTE_SOFT_DEADLINE_MIDDLE_SECONDS=18000
# ROUTE_SOFT_DEADLINE_LOW_SECONDS=28800
ROUTE_SOFT_UPPER_VIOLATION_COST_HIGH=5
ROUTE_SOFT_UPPER_VIOLATION_COST_MIDDLE=1
ROUTE_SOFT_UPPER_VIOLATION_COST_LOW=0


# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
