# Caddy — copy into .env (see caddy-local.md).
# ENVIRONMENT selects Caddyfile in Docker Compose and documents the TLS mode.

# local       -> Caddyfile.docker.local / caddy-local.ps1 -Local
# production  -> Caddyfile.docker.prod / Caddyfile + Let's Encrypt
ENVIRONMENT=local

DOMAIN=localhost.tiangolo.com
# ACME_EMAIL=admin@example.com   # required when ENVIRONMENT=production|staging

FRONTEND_HOST=https://dashboard.localhost.tiangolo.com
BACKEND_CORS_ORIGINS="https://dashboard.localhost.tiangolo.com"
