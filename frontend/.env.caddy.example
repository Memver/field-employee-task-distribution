# Copy to frontend/.env when using Caddy (see ../caddy-local.md).
# Replace example.com with your DOMAIN from root .env.

VITE_API_URL=https://api.example.com
VITE_CADDY_DEV=true
VITE_CADDY_HOST=dashboard.example.com
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
