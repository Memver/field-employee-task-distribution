# HTTPS via Let's Encrypt (Caddy on host, no Docker).
#
# Requirements:
#   - DOMAIN and ACME_EMAIL in .env (loaded by scripts/caddy-local.ps1)
#   - DNS: api.$DOMAIN and dashboard.$DOMAIN -> public IP of this machine
#   - Ports 80 and 443 open; backend :8000 and Vite :5173 running on this host
#
# Start:  .\scripts\caddy-local.ps1
# Local:  .\scripts\caddy-local.ps1 -Local  (Caddyfile.local, tls internal)

{
	email {$ACME_EMAIL}
	admin 127.0.0.1:20190
}

api.{$DOMAIN} {
	reverse_proxy 127.0.0.1:8000
}

dashboard.{$DOMAIN} {
	reverse_proxy 127.0.0.1:5173
}
