# Local HTTPS reverse proxy (no Docker).
# Requires: backend on :8000, Vite frontend on :5173.
# Domains resolve to 127.0.0.1 (localhost.tiangolo.com is preconfigured).
#
# Start:  caddy run --config Caddyfile
# Trust CA (once, admin):  caddy trust

{
	# Local development only — do not use "tls internal" in production.
	local_certs
	# IPv4 + non-default port: avoids [::1]:2019 issues on Windows when Caddy is not running yet.
	admin 127.0.0.1:20190
}

api.localhost.tiangolo.com {
	tls internal
	reverse_proxy 127.0.0.1:8000
}

dashboard.localhost.tiangolo.com {
	tls internal
	reverse_proxy 127.0.0.1:5173
}

